<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ปกติบังคับ HTTPS ทั้งหมด ยกเว้นไอพีในวง LAN ที่ยิงตรงเข้า NAS
         ซึ่งไม่ผ่าน reverse proxy จึงไม่มี TLS — ใช้เป็นทางสำรองตอนโดเมนล่ม -->
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.2.2</domain>
    </domain-config>
</network-security-config>
