{
  "name": "wedding-share",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted wedding photo & video sharing for NAS — Thai / Bahasa Melayu / English",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "check:booth": "node --env-file-if-exists=.env scripts/check-booth.mjs",
    "test:integration": "node --test test/booth-system-smoke.test.js photobooth/test/transfer-regressions.test.js photobooth/test/upload.test.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js && node --test --test-concurrency=2 photobooth/test/*.test.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "heic-convert": "^2.1.0",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  }
}
