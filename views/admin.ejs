<%- include('partials/head', { pageTitle: t('admin.title') }) %>

<section class="admin-head">
  <h1 class="admin-head__title"><%= t('admin.title') %></h1>
  <form method="post" action="/admin/logout">
    <button type="submit" class="button button--small button--ghost"><%= t('admin.logout') %></button>
  </form>
</section>

<%
  // ตัวเลขที่ต้องรู้ตลอดเวลามีสี่ตัว ส่วนคิวแปลงวิดีโอกับของที่รอตรวจเป็นเรื่อง
  // ชั่วคราว ขึ้นเฉพาะตอนมีจริง ไม่งั้นเลข 0 สองช่องจะแย่งที่ของข้อมูลที่สำคัญกว่า
  const figures = [
    { value: stats.photos, label: t('admin.stat_photos') },
    { value: stats.videos, label: t('admin.stat_videos') },
    { value: stats.messages, label: t('admin.stat_messages') },
    { value: stats.storage, label: t('admin.stat_storage') },
  ];
%>

<section class="stats">
  <% figures.forEach(function (figure) { %>
    <div class="stat">
      <span class="stat__value"><%= figure.value %></span>
      <span class="stat__label"><%= figure.label %></span>
    </div>
  <% }); %>
</section>

<% if (queue > 0 || stats.pending > 0) { %>
  <p class="admin-alert">
    <% if (queue > 0) { %><span><%= t('admin.stat_queue') %> · <%= queue %></span><% } %>
    <% if (stats.pending > 0) { %><span><%= t('admin.pending') %> · <%= stats.pending %></span><% } %>
  </p>
<% } %>

<section class="card">
  <h2 class="section-title"><%= t('admin.tools') %></h2>

  <div class="tools">
    <a class="tool tool--primary" href="/slideshow/menu" target="_blank" rel="noopener">
      <span class="tool__name"><%= t('admin.open_slideshow') %></span>
      <span class="tool__hint"><%= t('admin.slideshow_hint') %></span>
    </a>
    <a class="tool" href="/admin/qr" target="_blank" rel="noopener">
      <span class="tool__name"><%= t('admin.qr') %></span>
      <span class="tool__hint"><%= t('admin.qr_hint') %></span>
    </a>
    <a class="tool" href="/admin/qr?venue=0" target="_blank" rel="noopener">
      <span class="tool__name"><%= t('admin.qr_plain') %></span>
      <span class="tool__hint"><%= t('admin.qr_plain_hint') %></span>
    </a>
    <a class="tool" href="/admin/zip?videos=0">
      <span class="tool__name"><%= t('admin.download_photos') %></span>
      <span class="tool__hint"><%= t('admin.zip_photos_hint') %></span>
    </a>
    <a class="tool" href="/admin/zip">
      <span class="tool__name"><%= t('admin.download_all') %></span>
      <span class="tool__hint"><%= t('admin.zip_all_hint') %></span>
    </a>
  </div>
</section>

<%# เพลงคลอในหน้าแกลลอรี่ — ฟอร์มธรรมดา ไม่มี JavaScript
    แขกต้องกดปุ่มเองถึงจะเล่น จึงไม่มีไฟล์เสียงถูกดึงโดยคนที่ไม่ได้อยากฟัง %>
<% if (galleryMusic.library.length > 0) { %>
  <section class="card">
    <h2 class="section-title"><%= t('admin.music_gallery') %></h2>
    <p class="section-hint"><%= t('admin.music_gallery_hint') %></p>

    <form class="music-pick" method="post" action="/admin/music/gallery">
      <label class="field">
        <span class="visually-hidden"><%= t('admin.music_gallery') %></span>
        <select name="track">
          <option value=""><%= t('admin.music_gallery_off') %></option>
          <% galleryMusic.library.forEach(function (group) { %>
            <optgroup label="<%= t('film.theme_' + group.theme) %>">
              <% group.tracks.forEach(function (track) { %>
                <option value="<%= track.id %>"<%= galleryMusic.picked === track.id ? ' selected' : '' %>>
                  <%= track.title %>
                </option>
              <% }); %>
            </optgroup>
          <% }); %>
        </select>
      </label>
      <button type="submit" class="button button--small"><%= t('admin.save') %></button>
    </form>
  </section>
<% } %>

<%# หนังงานแต่ง — กดปุ่มเดียวแล้วรอ ไม่ต้อง ssh เข้า NAS
    สถานะเริ่มต้นถูกเรนเดอร์มาจากเซิร์ฟเวอร์แล้ว JavaScript แค่ทำให้มันสด %>
<section class="card film" id="film"
         data-state="<%= film.state || 'idle' %>"
         data-busy="<%= film.busyElsewhere ? '1' : '' %>">
  <h2 class="section-title"><%= t('film.heading') %></h2>
  <p class="section-hint"><%= t('film.hint') %></p>

  <div class="film__status" id="film-status" hidden>
    <div class="film__bar"><span class="film__bar-fill" id="film-bar"></span></div>
    <p class="film__line" id="film-phase"></p>
    <p class="film__note" id="film-detail"></p>
  </div>

  <form class="film__form" id="film-form">
    <%# ติ๊กได้ทั้งสองแบบ กดครั้งเดียวได้สองเรื่อง — ค่าเริ่มต้นคือทั้งคู่ %>
    <div class="film__styles">
      <span class="film__legend"><%= t('film.style') %></span>
      <label class="film__style">
        <input type="checkbox" name="style" value="cinema" checked>
        <span><%= t('film.style_cinema') %></span>
      </label>
      <label class="film__style">
        <input type="checkbox" name="style" value="wall" checked>
        <span><%= t('film.style_wall') %></span>
      </label>
    </div>

    <%# ตัวเลขที่โปรแกรมคิดเอง เติมด้วย JavaScript จาก /admin/film/plan %>
    <p class="film__plan" id="film-plan"><%= t('film.plan_loading') %></p>

    <div class="film__options">
      <label class="film__field">
        <span><%= t('film.seconds') %></span>
        <input type="number" name="seconds" value="" min="2" max="20" inputmode="numeric"
               placeholder="<%= t('film.seconds_auto') %>">
      </label>
      <label class="film__field">
        <span><%= t('film.video_seconds') %></span>
        <input type="number" name="maxVideoSeconds" value="30" min="5" max="120" inputmode="numeric">
      </label>
      <label class="film__toggle">
        <input type="checkbox" name="motion">
        <span><%= t('film.motion') %></span>
      </label>
    </div>

    <%# คลังเพลง — วาดด้วย JavaScript เพราะรายการเปลี่ยนได้ตลอดเวลาที่อัพเพลงเพิ่ม %>
    <div class="film__music">
      <h3 class="film__subtitle"><%= t('film.music') %></h3>
      <p class="film__note" id="film-music-empty" hidden><%= t('film.library_empty') %></p>
      <div class="film__themes" id="film-themes"></div>
      <p class="film__line" id="film-picked"></p>

      <label class="button button--tiny button--ghost">
        <%= t('film.music_choose') %>
        <input type="file" id="film-music-file" accept="audio/*" hidden>
      </label>
      <p class="film__note"><%= t('film.music_hint') %></p>
    </div>

    <button type="submit" class="button" id="film-start"><%= t('film.start') %></button>
    <p class="film__note"><%= t('film.takes_long') %></p>
  </form>

  <%# แกลเลอรีหนังที่เคยสร้าง — เรนเดอร์จากเซิร์ฟเวอร์ก่อน แล้ว JavaScript อัปเดตต่อ %>
  <h3 class="film__subtitle"><%= t('film.gallery') %> <span class="section-count" id="film-count"><%= film.films.length %></span></h3>
  <p class="film__note" id="film-empty" <%= film.films.length ? 'hidden' : '' %>><%= t('film.gallery_empty') %></p>
  <ul class="film__list" id="film-list">
    <% film.films.forEach(function (one) { %>
      <li class="film__item" data-id="<%= one.id %>">
        <video class="film__video" controls preload="none" playsinline
               src="/admin/film/<%= encodeURIComponent(one.id) %>/video"></video>
        <div class="film__meta">
          <span class="film__tag"><%= t(one.style === 'wall' ? 'film.style_wall' : 'film.style_cinema') %></span>
          <span class="film__note"><%= new Date(one.madeAt).toLocaleString() %> · <%= one.size %><%= one.music ? ' · ' + t('film.with_music') : '' %></span>
        </div>
        <div class="film__actions">
          <a class="button button--tiny" href="/admin/film/<%= encodeURIComponent(one.id) %>/download" download><%= t('film.download') %></a>
          <button type="button" class="button button--tiny button--danger film__delete"><%= t('film.delete') %></button>
        </div>
      </li>
    <% }); %>
  </ul>
</section>

<%# เอกสาร PDF — สมุดคำอวยพร กับ รายชื่อผู้ส่งภาพ
    โครงเดียวกับแผงหนัง: สถานะเรนเดอร์มาจากเซิร์ฟเวอร์ JavaScript แค่ทำให้มันสด %>
<section class="card film" id="paper" data-state="<%= paper.state || 'idle' %>">
  <h2 class="section-title"><%= t('paper.heading') %></h2>
  <p class="section-hint"><%= t('paper.hint') %></p>

  <div class="film__status" id="paper-status" hidden>
    <div class="film__bar"><span class="film__bar-fill" id="paper-bar"></span></div>
    <p class="film__line" id="paper-phase"></p>
  </div>

  <div class="film__actions">
    <button type="button" class="button" data-paper-kind="wishes"><%= t('paper.make_wishes') %></button>
    <button type="button" class="button" data-paper-kind="uploaders"><%= t('paper.make_uploaders') %></button>
  </div>
  <p class="film__note"><%= t('paper.takes_long') %></p>

  <h3 class="film__subtitle"><%= t('paper.gallery') %> <span class="section-count" id="paper-count"><%= paper.papers.length %></span></h3>
  <p class="film__note" id="paper-empty" <%= paper.papers.length ? 'hidden' : '' %>><%= t('paper.gallery_empty') %></p>
  <ul class="film__list film__list--flat" id="paper-list">
    <% paper.papers.forEach(function (one) { %>
      <li class="film__item" data-id="<%= one.id %>">
        <div class="film__meta">
          <span class="film__tag"><%= t(one.kind === 'uploaders' ? 'paper.kind_uploaders' : 'paper.kind_wishes') %></span>
          <span class="film__note"><%= new Date(one.madeAt).toLocaleString() %> · <%= one.size %><%= one.pages ? ' · ' + t('paper.pages', { n: one.pages }) : '' %></span>
        </div>
        <div class="film__actions">
          <a class="button button--tiny" href="/admin/paper/<%= encodeURIComponent(one.id) %>/view" target="_blank" rel="noopener"><%= t('paper.open') %></a>
          <a class="button button--tiny" href="/admin/paper/<%= encodeURIComponent(one.id) %>/download" download><%= t('paper.download') %></a>
          <button type="button" class="button button--tiny button--danger paper__delete"><%= t('paper.delete') %></button>
        </div>
      </li>
    <% }); %>
  </ul>
</section>

<%# รายชื่อแขก — เรนเดอร์ครบมาจากเซิร์ฟเวอร์ ช่องค้นหากรองแถวที่มีอยู่แล้วในหน้า
    ไม่ยิง API ทุกตัวอักษร เพราะจำนวนแขกมีขอบเขตชัดเจนไม่กี่ร้อยแถว %>
<section class="card guests" id="guests">
  <h2 class="section-title"><%= t('guests.heading') %> <span class="section-count"><%= guests.length %></span></h2>
  <label class="guests__search">
    <span class="visually-hidden"><%= t('guests.search') %></span>
    <input type="search" id="guests-search" placeholder="<%= t('guests.search') %>" autocomplete="off">
  </label>
  <p class="film__note" id="guests-none" hidden><%= t('guests.no_match') %></p>
  <% if (guests.length === 0) { %>
    <p class="film__note"><%= t('guests.empty') %></p>
  <% } %>
  <ul class="guests__list" id="guests-list">
    <% guests.forEach(function (guest) { %>
      <li class="guests__row" data-name="<%= (guest.anonymous ? t('gallery.anonymous') : guest.name).toLowerCase() %>">
        <a class="guests__name" href="/?who=<%= encodeURIComponent(guest.key) %>">
          <%= guest.anonymous ? t('gallery.anonymous') : guest.name %>
        </a>
        <span class="guests__counts">
          <% if (guest.photos) { %><span><%= guest.photos %> <%= t('guests.photos') %></span><% } %>
          <% if (guest.videos) { %><span><%= guest.videos %> <%= t('guests.videos') %></span><% } %>
          <% if (guest.messages) { %><span><%= guest.messages %> <%= t('guests.messages') %></span><% } %>
        </span>
      </li>
    <% }); %>
  </ul>
</section>

<section class="card">
  <h2 class="section-title"><%= t('admin.settings') %></h2>
  <form method="post" action="/admin/settings" class="settings">
    <label class="setting">
      <input type="checkbox" name="uploads_enabled" <%= uploadsEnabled ? 'checked' : '' %>>
      <span class="setting__text">
        <span class="setting__name"><%= t('admin.uploads_enabled') %></span>
        <span class="setting__hint"><%= t('admin.uploads_enabled_hint') %></span>
      </span>
    </label>
    <label class="setting">
      <input type="checkbox" name="require_review" <%= requireReview ? 'checked' : '' %>>
      <span class="setting__text">
        <span class="setting__name"><%= t('admin.review_required') %></span>
        <span class="setting__hint"><%= t('admin.review_required_hint') %></span>
      </span>
    </label>
    <button type="submit" class="button button--primary button--small settings__save"><%= t('admin.save') %></button>
  </form>
</section>

<section class="card">
  <h2 class="section-title"><%= t('admin.items') %> <span class="section-count"><%= items.length %></span></h2>

  <% if (items.length === 0) { %>
    <p class="notice"><%= t('admin.empty_items') %></p>
  <% } else { %>
    <div class="admin-grid">
      <% items.forEach(function (item) { %>
        <figure class="admin-item admin-item--<%= item.status %>">
          <div class="admin-item__frame">
            <% if (item.thumb_name) { %>
              <img loading="lazy" src="/thumb/<%= item.id %>" alt="">
            <% } else { %>
              <div class="admin-item__placeholder"><%= item.kind === 'video' ? '🎬' : '🖼' %></div>
            <% } %>

            <% if (item.kind === 'video') { %>
              <span class="admin-item__tag admin-item__tag--video"><%= t('common.video') %></span>
            <% } %>
            <% if (item.status === 'hidden') { %>
              <span class="admin-item__tag admin-item__tag--state"><%= t('admin.status_hidden') %></span>
            <% } else if (item.status === 'pending') { %>
              <span class="admin-item__tag admin-item__tag--state"><%= t('admin.status_pending') %></span>
            <% } %>
          </div>

          <figcaption>
            <span class="admin-item__who"><%= item.uploader || t('gallery.anonymous') %></span>

            <span class="admin-item__actions">
              <% if (item.status === 'pending') { %>
                <form method="post" action="/admin/items/<%= item.id %>/approve">
                  <button class="button button--tiny"><%= t('admin.approve') %></button>
                </form>
              <% } %>
              <% if (item.status === 'hidden') { %>
                <form method="post" action="/admin/items/<%= item.id %>/show">
                  <button class="button button--tiny"><%= t('admin.unhide') %></button>
                </form>
              <% } else { %>
                <form method="post" action="/admin/items/<%= item.id %>/hide">
                  <button class="button button--tiny"><%= t('admin.hide') %></button>
                </form>
              <% } %>
              <form method="post" action="/admin/items/<%= item.id %>/delete"
                    onsubmit="return confirm(<%= JSON.stringify(t('admin.confirm_delete')) %>)">
                <button class="button button--tiny button--danger"><%= t('admin.delete') %></button>
              </form>
            </span>
          </figcaption>
        </figure>
      <% }); %>
    </div>
  <% } %>
</section>

<section class="card">
  <h2 class="section-title"><%= t('guestbook.heading') %> <span class="section-count"><%= messages.length %></span></h2>

  <% if (messages.length === 0) { %>
    <p class="notice"><%= t('guestbook.empty') %></p>
  <% } else { %>
    <ul class="admin-messages">
      <% messages.forEach(function (message) { %>
        <li class="admin-message">
          <div class="admin-message__text">
            <strong><%= message.author || t('gallery.anonymous') %></strong>
            <p><%= message.body %></p>
          </div>
          <form method="post" action="/admin/messages/<%= message.id %>/delete"
                onsubmit="return confirm(<%= JSON.stringify(t('admin.confirm_delete')) %>)">
            <button class="button button--tiny button--danger"><%= t('admin.delete') %></button>
          </form>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>

<script src="/static/js/admin-film.js?v=<%= assetVersion %>" defer></script>
<script src="/static/js/admin-paper.js?v=<%= assetVersion %>" defer></script>

<%- include('partials/foot') %>
