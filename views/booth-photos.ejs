<%- include('partials/head', { pageTitle }) %>

<%#
  หน้าที่แขกเจอเมื่อสแกน QR บนกระดาษจากบูธ

  แขกยืนอยู่ที่ไหนก็ได้ อาจสแกนในงานหรือสแกนอีกสามเดือนให้หลัง · หน้านี้จึงต้อง
  อธิบายตัวเองได้โดยไม่ต้องมีใครมาบอก และต้องบอกตรง ๆ เมื่อของยังไม่พร้อม
%>

<%#
  สามสถานะ ไม่ใช่สองสถานะ — และการแยกสองอันแรกออกจากกันคือหัวใจของหน้านี้
  · ยังไม่ขึ้นระบบ = รูปกำลังจะมา ให้เก็บรหัสไว้แล้วกลับมาใหม่
  · หมดอายุแล้ว  = รูปถูกลบไปแล้ว ไม่มีวันกลับมา ให้ไปถามเจ้าภาพ
  บอกผิดข้อ แขกจะรอเก้อไปตลอด หรือเลิกรอทั้งที่รูปกำลังจะขึ้น
%>
<% if (expired) { %>
  <section class="card booth-wait booth-wait--expired">
    <h1 class="section-title"><%= t('booth.expired') %></h1>
    <p class="section-hint"><%= t('booth.expired_hint', { days: retentionDays }) %></p>
    <% if (expiredOn) { %>
      <p class="section-hint"><%= t('booth.expired_on', { date: expiredOn }) %></p>
    <% } %>
    <p class="booth-token"><%= t('booth.code') %> <strong><%= token %></strong></p>
  </section>
<% } else if (!session) { %>
  <section class="card booth-wait">
    <h1 class="section-title"><%= t('booth.not_yet') %></h1>
    <p class="section-hint"><%= t('booth.not_yet_hint') %></p>
    <p class="booth-token"><%= t('booth.code') %> <strong><%= token %></strong></p>
  </section>
<% } else { %>
  <section class="card booth-photos">
    <h1 class="section-title"><%= session.event_title || t('booth.title') %></h1>
    <p class="section-hint"><%= t('booth.hint') %></p>

    <figure class="booth-sheet">
      <img src="/p/<%= token %>/sheet" alt="<%= t('booth.sheet') %>" loading="lazy">
      <figcaption>
        <a class="button button--primary" href="/p/<%= token %>/sheet" download>
          <%= t('booth.download_sheet') %>
        </a>
      </figcaption>
    </figure>

    <% if (shots.length > 0) { %>
      <h2 class="section-title section-title--sub"><%= t('booth.originals') %></h2>
      <p class="section-hint"><%= t('booth.originals_hint') %></p>
      <div class="booth-grid">
        <% shots.forEach(function (shot, index) { %>
          <figure class="booth-shot">
            <img src="/p/<%= token %>/shot/<%= index + 1 %>" alt="" loading="lazy">
            <a class="button button--tiny" href="/p/<%= token %>/shot/<%= index + 1 %>" download>
              <%= t('booth.download') %>
            </a>
          </figure>
        <% }); %>
      </div>
    <% } %>

    <%# บอกวันหมดอายุตั้งแต่ตอนที่ยังโหลดได้ ไม่ใช่ตอนที่มันหายไปแล้ว %>
    <% if (keepsUntil) { %>
      <p class="booth-keeps"><%= t('booth.keeps_until', { date: keepsUntil }) %></p>
    <% } %>

    <p class="booth-token"><%= t('booth.code') %> <strong><%= token %></strong></p>
  </section>
<% } %>

<%- include('partials/foot') %>
