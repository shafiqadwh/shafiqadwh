<%- include('partials/head', { pageTitle: t('nav.gallery') }) %>

<%# ภาพปกกับชื่องานทาบอยู่บนภาพเดียวกัน ไม่ใช่ภาพวางเหนือชื่อ
    ชื่องานกับคำเชิญกินความสูงของมันเองอยู่แล้ว พอเอาไปทาบบนภาพ ภาพจึงแทบไม่ได้
    เพิ่มความสูงสุทธิ — ปุ่มอัปโหลดยังอยู่เหนือขอบล่างของจอมือถือเหมือนเดิม
    ซึ่งเป็นเรื่องเดียวที่หน้านี้ห้ามเสีย %>
<% if (locals.cover) { %>
  <section class="hero hero--cover<%= cover.width && cover.height && cover.height > cover.width ? ' hero--tall' : '' %>">
    <img class="hero__image" src="/host/<%= cover.id %>" alt=""
         <% if (cover.width && cover.height) { %>width="<%= cover.width %>" height="<%= cover.height %>"<% } %>>
    <div class="hero__veil">
      <h1 class="hero__title"><%= t('site.welcome') %></h1>
      <p class="hero__text"><%= t('site.share_hint') %></p>
    </div>
  </section>
<% } else { %>
  <section class="hero">
    <h1 class="hero__title"><%= t('site.welcome') %></h1>
    <p class="hero__text"><%= t('site.share_hint') %></p>
  </section>
<% } %>

<% if (uploadsOpen) { %>
  <section class="uploader" id="uploader">
    <h2 class="section-title"><%= t('upload.heading') %></h2>

    <label class="field">
      <span class="field__label"><%= t('upload.your_name') %></span>
      <input type="text" id="uploader-name" maxlength="60"
             placeholder="<%= t('upload.name_placeholder') %>" autocomplete="name">
    </label>

    <div class="dropzone" id="dropzone">
      <div class="dropzone__actions">
        <label class="button button--primary">
          <%= t('upload.choose') %>
          <input type="file" id="file-input" accept="image/*,video/*" multiple hidden>
        </label>

        <!-- capture ทำงานเฉพาะเมื่อ accept ระบุชนิดเดียว ถ้าใส่ทั้ง image/* และ
             video/* เบราว์เซอร์จะเลือกโหมดกล้องไม่ได้ แล้วถอยไปเปิดตัวเลือกไฟล์แทน
             จึงต้องแยกเป็นสองปุ่ม ปุ่มพวกนี้ซ่อนบนคอมเพราะเดสก์ท็อปไม่รองรับ capture -->
        <label class="button button--ghost camera-only">
          <%= t('upload.camera_photo') %>
          <input type="file" id="camera-photo" accept="image/*" capture="environment" hidden>
        </label>
        <label class="button button--ghost camera-only">
          <%= t('upload.camera_video') %>
          <input type="file" id="camera-video" accept="video/*" capture="environment" hidden>
        </label>
      </div>
      <p class="dropzone__hint"><%= t('upload.drop_hint') %></p>
      <p class="dropzone__limits">
        <%= t('upload.limits', { image: limits.imageMb, video: limits.videoMb, seconds: limits.videoSeconds }) %>
      </p>
    </div>

    <%# ตรวจก่อนส่ง — เลือกไฟล์แล้วยังไม่ส่งอะไรจนกว่าจะกดยืนยัน
        คลังภาพในมือถือเรียงตามเวลา รูปที่ไม่ได้ตั้งใจส่งจึงมักอยู่ติดกับรูปที่ตั้งใจส่งพอดี
        แผงนี้โชว์รูปย่อ "ของจริง" ไม่ใช่ชื่อไฟล์ เพราะ IMG_4823.HEIC บอกไม่ได้เลย
        ว่าเป็นรูปไหน ซึ่งคือทั้งหมดที่ฟีเจอร์นี้มีไว้กัน %>
    <section class="review" id="upload-review" hidden>
      <h3 class="review__title"><%= t('upload.review_title') %></h3>
      <p class="review__hint"><%= t('upload.review_hint') %></p>
      <div class="review__grid" id="review-grid"></div>
      <div class="review__actions">
        <button type="button" class="button button--primary" id="upload-confirm"></button>
        <button type="button" class="button button--ghost" id="upload-cancel"><%= t('upload.cancel_all') %></button>
      </div>
    </section>

    <ul class="queue" id="upload-queue" hidden></ul>
    <p class="notice" id="upload-status" role="status" hidden></p>
  </section>
<% } else { %>
  <section class="uploader uploader--closed">
    <h2 class="section-title"><%= t('upload.closed_title') %></h2>
    <p class="notice"><%= t('upload.closed_body') %></p>
  </section>
<% } %>

<%# การ์ดเชิญ — รูปย่อเล็ก ๆ แตะแล้วเปิดเต็มจอในตัวดูรูปตัวเดิม
    ไม่วางเต็มใบบนหน้าแรกเพราะการ์ดเชิญเกือบทั้งหมดเป็นแนวตั้งสูง วางเต็มใบแล้ว
    กินจอทั้งจอเพียงลำพัง และคนที่มางานแล้วส่วนใหญ่เห็นการ์ดมาก่อนแล้ว %>
<% if (locals.invitations && invitations.length > 0) { %>
  <section class="host-block">
    <h2 class="section-title"><%= t('home.invitation') %></h2>
    <div class="host-strip host-strip--invite" id="invite-strip">
      <% invitations.forEach(function (one, index) { %>
        <button type="button" class="host-thumb" data-invite="<%= index %>"
                aria-label="<%= t('home.invitation_open') %>">
          <img src="/host/<%= one.id %>?size=thumb" alt="" loading="lazy">
        </button>
      <% }) %>
    </div>
  </section>
<% } %>

<%# รูปงานที่เจ้าภาพอัพไว้ — แถบเลื่อนแนวนอน กินความสูงคงที่ไม่ว่าจะใส่กี่รูป
    ตารางรูปสิบสองใบกินความสูงมหาศาลบนมือถือแล้วไปเบียดแกลลอรี่ของแขกซึ่งเป็นของหลัก %>
<% if (locals.hostPhotos && hostPhotos.length > 0) { %>
  <section class="host-block">
    <h2 class="section-title"><%= t('home.photos') %></h2>
    <div class="host-strip" id="host-strip">
      <% hostPhotos.forEach(function (one, index) { %>
        <button type="button" class="host-thumb host-thumb--wide" data-host="<%= index %>"
                aria-label="<%= one.caption || t('home.photos') %>">
          <img src="/host/<%= one.id %>?size=thumb" alt="<%= one.caption || '' %>" loading="lazy">
        </button>
      <% }) %>
    </div>
  </section>
<% } %>

<section class="gallery">
  <div class="gallery__bar">
    <h2 class="section-title"><%= t('gallery.heading') %></h2>
    <div class="filters" role="group">
      <button class="chip is-active" data-filter="all"><%= t('gallery.filter_all') %></button>
      <button class="chip" data-filter="photos"><%= t('gallery.filter_photos') %></button>
      <button class="chip" data-filter="videos"><%= t('gallery.filter_videos') %></button>
    </div>
  </div>

  <%# ค้นหาชื่อผู้ส่ง — เป็นฟอร์มจริงที่ส่ง GET ไม่ใช่ JavaScript ล้วน
      แขกที่ปิด JS หรือกล่องทีวีรุ่นเก่าจึงยังค้นได้ และลิงก์ที่ได้ส่งต่อกันได้ %>
  <form class="gallery__search" method="get" action="/" role="search">
    <label class="visually-hidden" for="who"><%= t('guests.search') %></label>
    <input type="search" id="who" name="who" value="<%= locals.who || '' %>"
           placeholder="<%= t('guests.search') %>" autocomplete="off">
    <button type="submit" class="button button--tiny"><%= t('guests.search') %></button>
    <% if (locals.who) { %>
      <a class="button button--tiny button--ghost" href="/"><%= t('guests.clear') %></a>
    <% } %>
  </form>

  <% if (locals.who) { %>
    <p class="gallery__showing"><%= t('guests.showing', { name: locals.guestName || locals.who }) %></p>
  <% } %>

  <p class="gallery__count" id="gallery-count"><%= t('gallery.count', { n: total }) %></p>

  <button class="new-items" id="new-items" hidden></button>

  <div class="grid" id="grid" aria-live="polite" data-who="<%= locals.who || '' %>"></div>

  <div class="empty" id="empty" hidden>
    <p class="empty__title"><%= t('gallery.empty_title') %></p>
    <p class="empty__text"><%= t('gallery.empty_body') %></p>
  </div>

  <button class="button button--ghost load-more" id="load-more" hidden><%= t('gallery.load_more') %></button>
</section>

<div class="lightbox" id="lightbox" hidden>
  <button class="lightbox__close" id="lightbox-close" aria-label="<%= t('common.close') %>">&times;</button>
  <button class="lightbox__nav lightbox__nav--prev" id="lightbox-prev" aria-label="<%= t('gallery.prev') %>">&#8249;</button>
  <div class="lightbox__stage" id="lightbox-stage"></div>
  <button class="lightbox__nav lightbox__nav--next" id="lightbox-next" aria-label="<%= t('gallery.next') %>">&#8250;</button>
  <div class="lightbox__meta">
    <span id="lightbox-caption"></span>
    <a class="button button--small" id="lightbox-download" download><%= t('gallery.download_item') %></a>
  </div>
</div>

<%# รายการรูปของเจ้าภาพให้ JS หยิบไปเปิดในตัวดูรูปตัวเดิม
    ส่งเป็น JSON ในหน้า ไม่ต้องยิง API เพิ่ม เพราะเป็นรายการสั้นที่รู้ตั้งแต่เรนเดอร์แล้ว %>
<script type="application/json" id="host-media"><%- JSON.stringify({
  invitations: (locals.invitations || []).map((one) => ({ url: `/host/${one.id}`, caption: one.caption || '' })),
  photos: (locals.hostPhotos || []).map((one) => ({ url: `/host/${one.id}`, caption: one.caption || '' })),
}) %></script>

<script src="/static/js/upload.js?v=<%= assetVersion %>" defer></script>
<script src="/static/js/gallery.js?v=<%= assetVersion %>" defer></script>

<%- include('partials/foot') %>
