<%#
  ธงชาติเป็น SVG ไม่ใช่ emoji — Windows ไม่มีฟอนต์ธง emoji จะแสดงเป็นตัวอักษร
  "TH" "MY" แทนรูปธง ส่วน SVG แสดงเหมือนกันทุกเครื่อง
  วาดครั้งเดียวเป็น sprite แล้วอ้างด้วย <use> ในทุกจุดที่ต้องใช้
%>
<svg class="flag-sprite" aria-hidden="true" focusable="false">
  <!-- ไทย · อัตราส่วน 2:3 — แดง / ขาว / น้ำเงิน (หนาสองเท่า) / ขาว / แดง -->
  <symbol id="flag-th" viewBox="0 0 60 40">
    <rect width="60" height="40" fill="#f4f5f8"/>
    <rect width="60" height="6.67" y="0" fill="#a51931"/>
    <rect width="60" height="13.33" y="13.33" fill="#2d2a4a"/>
    <rect width="60" height="6.67" y="33.33" fill="#a51931"/>
  </symbol>

  <!-- มาเลเซีย · อัตราส่วน 1:2 — 14 ริ้ว, canton, จันทร์เสี้ยวและดาว 14 แฉก -->
  <symbol id="flag-ms" viewBox="0 0 60 30">
    <rect width="60" height="30" fill="#fff"/>
    <g fill="#cc0001">
      <rect width="60" height="2.143" y="0"/>
      <rect width="60" height="2.143" y="4.286"/>
      <rect width="60" height="2.143" y="8.571"/>
      <rect width="60" height="2.143" y="12.857"/>
      <rect width="60" height="2.143" y="17.143"/>
      <rect width="60" height="2.143" y="21.429"/>
      <rect width="60" height="2.143" y="25.714"/>
    </g>
    <rect width="30" height="17.143" fill="#010066"/>
    <!-- จันทร์เสี้ยว: วงกลมเหลืองซ้อนด้วยวงกลมสีเดียวกับ canton -->
    <circle cx="13.2" cy="8.6" r="5.2" fill="#ffcc00"/>
    <circle cx="15.4" cy="8.6" r="4.4" fill="#010066"/>
    <polygon fill="#ffcc00" points="20.50,4.00 20.95,6.65 22.50,4.46 21.75,7.04 24.10,5.73 22.30,7.73 24.98,7.58 22.50,8.60 24.98,9.62 22.30,9.47 24.10,11.47 21.75,10.16 22.50,12.74 20.95,10.55 20.50,13.20 20.05,10.55 18.50,12.74 19.25,10.16 16.90,11.47 18.70,9.47 16.02,9.62 18.50,8.60 16.02,7.58 18.70,7.73 16.90,5.73 19.25,7.04 18.50,4.46 20.05,6.65"/>
  </symbol>

  <!-- สหราชอาณาจักร แทนภาษาอังกฤษ · อัตราส่วน 1:2 -->
  <symbol id="flag-en" viewBox="0 0 60 30">
    <clipPath id="flag-en-clip"><rect width="60" height="30"/></clipPath>
    <g clip-path="url(#flag-en-clip)">
      <rect width="60" height="30" fill="#012169"/>
      <path d="M0,0 60,30 M60,0 0,30" stroke="#fff" stroke-width="6"/>
      <path d="M0,0 60,30 M60,0 0,30" stroke="#c8102e" stroke-width="3.5"/>
      <path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10"/>
      <path d="M30,0 V30 M0,15 H60" stroke="#c8102e" stroke-width="6"/>
    </g>
  </symbol>
</svg>
