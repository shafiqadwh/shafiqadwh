<!doctype html>
<html lang="<%= htmlLang %>" dir="<%= htmlDir %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f7f1ea">
  <title><%= event.title %><%= typeof pageTitle !== 'undefined' ? ' · ' + pageTitle : '' %></title>
  <link rel="stylesheet" href="/static/css/app.css?v=<%= assetVersion %>">
<%_ if (themeStyle) { _%>
  <%# สีต่องานทับตัวแปรใน app.css ตรงนี้ ไม่ได้แก้ไฟล์ CSS — งานที่ไม่ตั้งสีเองจะไม่มีบรรทัดนี้เลย %>
  <style><%- themeStyle %></style>
<%_ } _%>
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
</head>
<body data-page="<%= page %>">
  <%- include('flags') %>

  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="/">
        <span class="brand__names"><%= event.names || event.title %></span>
        <% if (event.date) { %><span class="brand__date"><%= event.date %></span><% } %>
      </a>

      <%# ลำดับภาษาตามที่ตั้งไว้ใน config: ไทย → มลายู → อังกฤษ → อาหรับ %>
      <nav class="lang" aria-label="<%= t('common.language') %>">
        <% languages.forEach(function (option) { %>
          <a class="lang__option <%= option.code === lang ? 'is-active' : '' %>"
             href="<%= currentPath %>?lang=<%= option.code %>"
             lang="<%= option.code %>"
             title="<%= option.name %>"
             aria-label="<%= option.name %>"
             aria-current="<%= option.code === lang ? 'true' : 'false' %>">
            <%# ภาษาที่ยังไม่มีธงใน sprite ใช้ตัวอักษรเดี่ยวขนาดเท่ากับธงบวกรหัสแทน
                ไม่ใช่ <use> ที่ชี้ไป symbol ที่ไม่มีอยู่ ซึ่งขึ้นเป็นกล่องว่าง %>
            <% if (option.flag) { %>
              <svg class="lang__flag" aria-hidden="true" focusable="false"><use href="#flag-<%= option.code %>"/></svg>
              <span class="lang__code"><%= option.short %></span>
            <% } else { %>
              <span class="lang__glyph"><%= option.short %></span>
            <% } %>
          </a>
        <% }); %>
      </nav>
    </div>

    <nav class="tabs">
      <a class="tabs__link <%= page === 'gallery' ? 'is-active' : '' %>" href="/"><%= t('nav.gallery') %></a>
      <a class="tabs__link <%= page === 'guestbook' ? 'is-active' : '' %>" href="/guestbook"><%= t('nav.guestbook') %></a>
      <% if (isAdmin) { %>
        <a class="tabs__link <%= page === 'admin' ? 'is-active' : '' %>" href="/admin"><%= t('nav.admin') %></a>
      <% } %>
    </nav>
  </header>

  <main class="page">
