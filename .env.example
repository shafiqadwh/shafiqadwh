# ── งานแต่ง ───────────────────────────────────────────────────────────────
EVENT_TITLE=Sofwan & 'Aishah Nadhirah
COUPLE_NAMES=Sofwan & 'Aishah Nadhirah
# ตัวอักษรย่อบนการ์ด QR — เว้นว่างได้ ระบบจะย่อจาก COUPLE_NAMES ให้เอง
EVENT_MONOGRAM=S & N
EVENT_DATE=29.08.2026
# สถานที่และเวลา แสดงบนการ์ด QR ให้แขกอ่านคู่กัน (เว้นว่างได้)
EVENT_VENUE=Hasanah Restaurant (ร้านอาหารฮาซานะห์) Sateng, Yala
EVENT_TIME=11.00 - 16.00

# ที่อยู่ที่แขกจะเข้า ใช้สร้าง QR code — ต้องเป็น https ที่เข้าได้จากภายนอก
BASE_URL=https://wedding.shafiq-lap.com

# ── ความปลอดภัย ──────────────────────────────────────────────────────────
# บังคับตั้ง อย่างน้อย 8 ตัวอักษร ใช้เข้าหน้า /admin
ADMIN_PASSWORD=เปลี่ยนรหัสนี้ด้วย
ADMIN_SESSION_HOURS=12

# ── ภาษา ─────────────────────────────────────────────────────────────────
# ภาษาเริ่มต้นเมื่อเดาจากเครื่องของแขกไม่ได้: th | ms | en | ar
DEFAULT_LANGUAGE=th

# ── ขนาดไฟล์ ─────────────────────────────────────────────────────────────
MAX_IMAGE_MB=25
MAX_VIDEO_MB=300
MAX_VIDEO_SECONDS=180
MAX_FILES_PER_UPLOAD=20
# จำกัดพื้นที่รวมทั้งงาน (GB) — 0 คือใช้ได้จนกว่าดิสก์จะเต็ม
MAX_TOTAL_STORAGE_GB=0

# ── โควตากันคนกดรัว ──────────────────────────────────────────────────────
# นับต่อ "เครื่อง" ของแขก ไม่ใช่ต่อไอพี เพราะแขกที่ต่อ WiFi ของสถานที่จัดงาน
# หรือใช้ 4G ผ่าน CGNAT ของค่าย จะออกเน็ตด้วยไอพีเดียวกันเป็นร้อยเครื่อง
UPLOADS_PER_HOUR_PER_DEVICE=80
MESSAGES_PER_HOUR_PER_DEVICE=12

# เพดานรวมต่อไอพี เป็นชั้นกันการยิงถล่มเท่านั้น ตั้งสูงพอไม่ให้ไปโดนแขกปกติ
UPLOADS_PER_HOUR_PER_IP=4000
MESSAGES_PER_HOUR_PER_IP=800

# ── การอัพโหลด ───────────────────────────────────────────────────────────
UPLOADS_ENABLED=true
REQUIRE_REVIEW=false
# เปิดรับเฉพาะช่วงเวลา เว้นว่าง = เปิดตลอด
# งานนี้: เสาร์ 29 ส.ค. 2026 เวลา 11.00-16.00 น. — เผื่อหัวท้ายไว้กว้าง ๆ
# UPLOAD_WINDOW=2026-08-29 08:00 / 2026-08-30 23:59
UPLOAD_WINDOW=

# ── วิดีโอ ───────────────────────────────────────────────────────────────
# แปลง .mov/HEVC ของ iPhone เป็น mp4 H.264 ให้ Android เปิดได้
CONVERT_VIDEOS=true
FFMPEG_THREADS=2

# จำนวนงาน ffmpeg ที่ทำพร้อมกันได้ตอนแขกยืนรอ (อ่านข้อมูลวิดีโอ + ดึงภาพปก)
# ตั้งสูงกว่านี้ไม่ได้ทำให้เร็วขึ้น คอขวดคือดิสก์กับ CPU ของ NAS
MEDIA_CONCURRENCY=2

# ตัวเข้ารหัสวิดีโอ ใช้เฉพาะไฟล์ HEVC ที่ต้องบีบอัดใหม่จริง ๆ เท่านั้น
# ไฟล์ที่เป็น H.264 อยู่แล้ว (รวม .mov จาก iPhone แบบ Most Compatible)
# จะถูกคัดลอกสตรีมตรง ๆ ไม่ผ่านตัวนี้ และไม่เสียคุณภาพ
VIDEO_ENCODER=libx264
VIDEO_ENCODER_ARGS=-preset veryfast -crf 24 -profile:v high
VIDEO_DECODER_ARGS=

# ถ้ามี GPU NVIDIA ที่ผ่านเข้ามาถึงในคอนเทนเนอร์ได้จริงแล้ว ให้ใช้ค่าชุดนี้แทน
# ตรวจก่อนเสมอ: docker exec wedding-share ffmpeg -encoders | grep nvenc
#   VIDEO_ENCODER=h264_nvenc
#   VIDEO_ENCODER_ARGS=-preset p4 -cq 24
#   VIDEO_DECODER_ARGS=-hwaccel cuda

# ── สไลด์โชว์ ────────────────────────────────────────────────────────────
SLIDESHOW_SECONDS=8
SLIDESHOW_VIDEO_MAX_SECONDS=30
SLIDESHOW_MUTED=true

# แทรกอะไรทุกกี่สไลด์ (ใส่ 0 เพื่อปิด)
SLIDESHOW_MESSAGE_EVERY=5
SLIDESHOW_QR_EVERY=12
SLIDESHOW_TITLE_EVERY=24

# เวลาอ่านคำอวยพรขั้นต่ำ — ข้อความยาวจะได้เวลาเพิ่มเองตามจำนวนตัวอักษร
SLIDESHOW_MESSAGE_SECONDS=11

# ซูมช้า ๆ แบบ Ken Burns ตั้ง false ถ้าเครื่องฉายกระตุก
SLIDESHOW_KEN_BURNS=true

# รูปแบบการแสดงผล
#   cinema = ทีละรูปเต็มจอ สลับกันไป (ค่าเริ่มต้น)
#   wall   = กระจายทั้งจอเหมือนรูปโพลารอยด์วางบนโต๊ะ แล้ววนยกทีละใบขึ้นมาเป็นไฮไลท์
# สลับดูสด ๆ ได้ด้วยการต่อท้าย ?mode=wall หรือ ?mode=cinema ที่ท้าย URL
SLIDESHOW_MODE=cinema

# ── ระบบ ─────────────────────────────────────────────────────────────────
PORT=3000
TZ=Asia/Bangkok
THUMBNAIL_SIZE=720
# ขนาดรูปที่ส่งให้สไลด์โชว์ — เล็กลงถ้ากล่องทีวียังกระตุก
DISPLAY_SIZE=1920

# ── การเผยแพร่พอร์ตบน NAS ────────────────────────────────────────────────
# พอร์ตบนโฮสต์ที่ reverse proxy ของ DSM จะยิงเข้ามา
HTTP_PORT=18090
# 127.0.0.1 = เข้าได้เฉพาะจากบน NAS (มาตรฐาน — บังคับให้ผ่าน reverse proxy + TLS)
# 0.0.0.0   = เปิดสู่ LAN ชั่วคราวเพื่อทดสอบจากมือถือก่อนตั้ง reverse proxy
BIND_ADDR=127.0.0.1
# เจ้าของโฟลเดอร์บน DSM — หาด้วยคำสั่ง id
PUID=1026
PGID=100
