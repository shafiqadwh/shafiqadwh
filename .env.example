# ── งานนี้คืองานอะไร ──────────────────────────────────────────────────────
# ประเภทงาน เปลี่ยนคำบนหน้าเว็บให้เข้ากับงาน (เช่น งานวันเกิดจะไม่พูดว่า "บ่าวสาว")
# เลือกได้: wedding · engagement · birthday · graduation · office · other
EVENT_KIND=wedding
EVENT_TITLE=Sofwan & 'Aishah Nadhirah
# ชื่อเจ้าของงาน — งานแต่งใส่สองชื่อ งานวันเกิด/รับปริญญาใส่ชื่อเดียวก็ได้
# (ชื่อเดิม COUPLE_NAMES ยังใช้ได้ ระบบอ่านให้ทั้งสองชื่อ)
EVENT_NAMES=Sofwan & 'Aishah Nadhirah
# ตัวอักษรย่อบนการ์ด QR — เว้นว่างได้ ระบบจะย่อจาก EVENT_NAMES ให้เอง
EVENT_MONOGRAM=S & N
EVENT_DATE=29.08.2026
# สถานที่และเวลา แสดงบนการ์ด QR ให้แขกอ่านคู่กัน (เว้นว่างได้)
EVENT_VENUE=Hasanah Restaurant (ร้านอาหารฮาซานะห์) Sateng, Yala
EVENT_TIME=11.00 - 16.00

# ที่อยู่ที่แขกจะเข้า ใช้สร้าง QR code — ต้องเป็น https ที่เข้าได้จากภายนอก
BASE_URL=https://wedding.shafiq-lap.com

# ── สีของงาน ──────────────────────────────────────────────────────────────
# รับเฉพาะรหัสสีแบบ #rrggbb หรือ #rgb เท่านั้น · ค่าอื่นถูกเมิน
# เว้นว่างทั้งสี่ตัว = ใช้จานสีทองบนขาวเดิม ไม่มี <style> โผล่ในหน้าเลย
THEME_ACCENT=
THEME_ACCENT_DARK=
THEME_PAPER=
THEME_BLUSH=

# ── รูปจาก photo booth ───────────────────────────────────────────────────
# กุญแจที่เครื่องบูธใช้ส่งรอบถ่ายขึ้นมา แล้ว QR บนกระดาษจะพาแขกมาที่ /p/<รหัส>
# **เว้นว่าง = ปิดรับทั้งเส้นทาง** ซึ่งเป็นค่าเริ่มต้นที่ปลอดภัย
# ต้องเป็น ASCII (เดินทางเป็น HTTP header) และยาวอย่างน้อย 16 ตัว
# สร้างด้วย: openssl rand -base64 24
BOOTH_KEY=

# ── ความปลอดภัย ──────────────────────────────────────────────────────────
# บังคับตั้ง อย่างน้อย 8 ตัวอักษร ใช้เข้าหน้า /admin
ADMIN_PASSWORD=เปลี่ยนรหัสนี้ด้วย
ADMIN_SESSION_HOURS=12
# รูปที่ลบใน /admin เข้าถังขยะก่อน กู้คืนได้ในหน้า admin เอง ลบถาวรจริงหลังผ่านไปกี่วัน
TRASH_RETENTION_DAYS=7

# ── ภาษา ─────────────────────────────────────────────────────────────────
# ภาษาเริ่มต้นเมื่อเดาจากเครื่องของแขกไม่ได้: th | ms | en | ar
DEFAULT_LANGUAGE=th

# ── ขนาดไฟล์ ─────────────────────────────────────────────────────────────
MAX_IMAGE_MB=25
MAX_VIDEO_MB=300
MAX_VIDEO_SECONDS=180
MAX_FILES_PER_UPLOAD=20
# จำกัดพื้นที่รวมทั้งงาน (GB) — 0 คือใช้ได้จนกว่าดิสก์จะเต็ม
MAX_TOTAL_STORAGE_GB=0

# ── โควตากันคนกดรัว ──────────────────────────────────────────────────────
# นับต่อ "เครื่อง" ของแขก ไม่ใช่ต่อไอพี เพราะแขกที่ต่อ WiFi ของสถานที่จัดงาน
# หรือใช้ 4G ผ่าน CGNAT ของค่าย จะออกเน็ตด้วยไอพีเดียวกันเป็นร้อยเครื่อง
UPLOADS_PER_HOUR_PER_DEVICE=80
MESSAGES_PER_HOUR_PER_DEVICE=12

# เพดานรวมต่อไอพี เป็นชั้นกันการยิงถล่มเท่านั้น ตั้งสูงพอไม่ให้ไปโดนแขกปกติ
UPLOADS_PER_HOUR_PER_IP=4000
MESSAGES_PER_HOUR_PER_IP=800

# ── การอัพโหลด ───────────────────────────────────────────────────────────
UPLOADS_ENABLED=true
REQUIRE_REVIEW=false
# เปิดรับเฉพาะช่วงเวลา เว้นว่าง = เปิดตลอด
# งานนี้: เสาร์ 29 ส.ค. 2026 เวลา 11.00-16.00 น. — เผื่อหัวท้ายไว้กว้าง ๆ
# UPLOAD_WINDOW=2026-08-29 08:00 / 2026-08-30 23:59
UPLOAD_WINDOW=

# ── วิดีโอ ───────────────────────────────────────────────────────────────
# แปลง .mov/HEVC ของ iPhone เป็น mp4 H.264 ให้ Android เปิดได้
CONVERT_VIDEOS=true
FFMPEG_THREADS=2

# จำนวนงาน ffmpeg ที่ทำพร้อมกันได้ตอนแขกยืนรอ (อ่านข้อมูลวิดีโอ + ดึงภาพปก)
# ตั้งสูงกว่านี้ไม่ได้ทำให้เร็วขึ้น คอขวดคือดิสก์กับ CPU ของ NAS
MEDIA_CONCURRENCY=2

# ตัวเข้ารหัสวิดีโอ ใช้เฉพาะไฟล์ HEVC ที่ต้องบีบอัดใหม่จริง ๆ เท่านั้น
# ไฟล์ที่เป็น H.264 อยู่แล้ว (รวม .mov จาก iPhone แบบ Most Compatible)
# จะถูกคัดลอกสตรีมตรง ๆ ไม่ผ่านตัวนี้ และไม่เสียคุณภาพ
VIDEO_ENCODER=libx264
VIDEO_ENCODER_ARGS=-preset veryfast -crf 24 -profile:v high
VIDEO_DECODER_ARGS=
# ตั้ง VIDEO_ENCODER ที่เดียว คุมทั้งคิวแปลงวิดีโอสดและการ export หนัง (FILM_ENCODER_ARGS
# อยู่ในหมวด "ระบบ" ด้านล่าง แยกไว้เพราะหนังใช้คุณภาพสูงกว่า)

# ⚠️ อย่าตั้ง h264_nvenc ไว้ตรงนี้ — ค่าใน .env อยู่ถาวร แต่ GPU ต่อเข้าคอนเทนเนอร์
# หรือเปล่าเปลี่ยนได้ทุกครั้งที่ยกคอนเทนเนอร์ พอสองอย่างไม่ตรงกัน ffmpeg จะล้มด้วย
# "Cannot load libnvidia-encode.so.1" ทุกครั้งที่ต้องเข้ารหัส เว็บยังดูปกติทุกอย่าง
# แต่คลิปที่แขกส่งมาแปลงไม่ผ่านสักไฟล์ (เกิดขึ้นจริงมาแล้ว)
#
# ค่าของ GPU อยู่ใน docker-compose.gpu.yml แทน — ไฟล์นั้นถูกใส่เข้ามาก็ต่อเมื่อ
# ตรวจแล้วว่า GPU ใช้ได้จริง "ขอ GPU" กับ "สั่งใช้ nvenc" จึงมาด้วยกันเสมอ
# ดูบทที่ 7 หัวข้อ GPU

# ── สไลด์โชว์ ────────────────────────────────────────────────────────────
SLIDESHOW_SECONDS=8
SLIDESHOW_VIDEO_MAX_SECONDS=30
SLIDESHOW_MUTED=true

# แทรกอะไรทุกกี่สไลด์ (ใส่ 0 เพื่อปิด)
SLIDESHOW_MESSAGE_EVERY=5
SLIDESHOW_QR_EVERY=12
SLIDESHOW_TITLE_EVERY=24

# เวลาอ่านคำอวยพรขั้นต่ำ — ข้อความยาวจะได้เวลาเพิ่มเองตามจำนวนตัวอักษร
SLIDESHOW_MESSAGE_SECONDS=11

# ซูมช้า ๆ แบบ Ken Burns ตั้ง false ถ้าเครื่องฉายกระตุก
SLIDESHOW_KEN_BURNS=true

# รูปแบบการแสดงผล
#   cinema = ทีละรูปเต็มจอ สลับกันไป (ค่าเริ่มต้น)
#   wall   = กระจายทั้งจอเหมือนรูปโพลารอยด์วางบนโต๊ะ แล้ววนยกทีละใบขึ้นมาเป็นไฮไลท์
# สลับดูสด ๆ ได้ด้วยการต่อท้าย ?mode=wall หรือ ?mode=cinema ที่ท้าย URL
SLIDESHOW_MODE=cinema

# ── ระบบ ─────────────────────────────────────────────────────────────────
PORT=3000
TZ=Asia/Bangkok
THUMBNAIL_SIZE=720
# ขนาดรูปที่ส่งให้สไลด์โชว์ — เล็กลงถ้ากล่องทีวียังกระตุก
DISPLAY_SIZE=1920

# ── การเผยแพร่พอร์ตบน NAS ────────────────────────────────────────────────
# พอร์ตบนโฮสต์ที่ reverse proxy ของ DSM จะยิงเข้ามา
HTTP_PORT=18090
# 127.0.0.1 = เข้าได้เฉพาะจากบน NAS (มาตรฐาน — บังคับให้ผ่าน reverse proxy + TLS)
# 0.0.0.0   = เปิดสู่ LAN ชั่วคราวเพื่อทดสอบจากมือถือก่อนตั้ง reverse proxy
BIND_ADDR=127.0.0.1
# เจ้าของโฟลเดอร์บน DSM — หาด้วยคำสั่ง id
PUID=1026
PGID=100

# ── Cloudflare (ให้ระเบียน DNS ตามไอพีบ้านเองอัตโนมัติ) ───────────────────
# ปล่อยว่างไว้ แล้วตั้งค่าด้วย  sudo ./scripts/cloudflare-ddns.sh --setup
# สคริปต์จะถามโทเคนทีละบรรทัด ตรวจกับ Cloudflare ให้ก่อน แล้วเขียนลงบรรทัดนี้เอง
# โทเคนต้องการสิทธิ์แค่ Zone → DNS → Edit ของโซนเดียว ไม่ต้องให้มากกว่านั้น
CLOUDFLARE_API_TOKEN=

# ── หนังงานแต่ง (ปล่อยว่างไว้ก็ได้ ค่าเริ่มต้นใช้ CPU ทำงานได้ทุกเครื่อง) ──────────
# คุณภาพของหนัง export — ตัวเข้ารหัสตั้งที่ VIDEO_ENCODER ด้านบน (ใช้ตัวเดียวกัน)
# ตั้งค่านี้คู่กับ VIDEO_ENCODER_ARGS เสมอเวลาสลับ CPU/GPU (ดูคอมเมนต์ด้านบน)
FILM_ENCODER_ARGS=
